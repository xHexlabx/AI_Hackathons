# ── Data, models & run artifacts (any project depth) ─────────────────────────
# Keep folder skeletons via .gitkeep, ignore everything else inside them.
**/data/**
!**/data/**/
!**/data/**/.gitkeep
**/datasets/
**/database/
**/features/
**/submissions/**
!**/submissions/**/
!**/submissions/**/.gitkeep
**/models/**
!**/models/**/
!**/models/**/.gitkeep
**/episodes/**
!**/episodes/**/
!**/episodes/**/.gitkeep
**/AutogluonModels/
**/runs/
**/lightning_logs/
**/wandb/
**/mlruns/
**/outputs/
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.pkl
*.joblib
*.zip
*.tar.gz

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
build/
dist/

# ── Secrets & local config (never commit tokens) ─────────────────────────────
.env
.env.*
kaggle.json
*.secret

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
